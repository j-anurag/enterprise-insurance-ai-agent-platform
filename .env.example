# PostgreSQL Database Configuration
POSTGRES_DB=claimwise
POSTGRES_USER=claimwise
POSTGRES_PASSWORD=claimwise_password
POSTGRES_HOST_PORT=5433

# Application Configuration
APP_PORT=8080

# Hugging Face Embeddings Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Groq LLM Configuration (Stage 3 Scaffolding)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
